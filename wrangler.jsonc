{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corsi",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // ADMIN_EMAIL si imposta dalla dashboard: non va sovrascritta al deploy
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /d/<token> è il link personale dell'istruttore: il Worker serve disponibilita.html
    "run_worker_first": ["/api/*", "/d/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corsi",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": { "enabled": true }
}
